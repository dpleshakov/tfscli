# Binaries, and the archives goreleaser builds into dist/
/tfscli
/tfscli.exe
/dist/

# The third-party licenses the release build generates for each platform; the
# PLACEHOLDER beside each third-party/ is committed.
/internal/licenses/embed/*/third-party/

# Test and coverage artifacts
*.test
*.out
coverage.html

# A local config file — personal settings, never committed. Credentials are not kept here; they live in auth.json.
config.json

# IDE
.idea/
.vs/
.vscode/
